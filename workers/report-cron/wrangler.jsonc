{
  "name": "jxshoes-report-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": [
      "0 2 * * 1",
      "0 2 1 * *"
    ]
  },
  "vars": {
    "SITE_URL": "https://shopkeeperbd.pages.dev",
    "NOTE": "SITE_URL আপনার Pages ডোমেইন (কাস্টম ডোমেইন থাকলে সেটা)। CRON_SECRET সিক্রেট হিসেবে বসাতে হবে।"
  }
}
